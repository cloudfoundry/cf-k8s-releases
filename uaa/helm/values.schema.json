{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "commonLabels": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "string"
      }
    },
    "serviceLabels": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "string"
      }
    },
    "serviceAnnotations": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "string"
      }
    },
     "global": {
      "type": "object"
    },
    "systemDomain": {
      "type": "string"
    },
    "replicas": {
      "type": "integer"
    },
    "image": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "imagePullPolicy": {
          "type": "string"
        }
      }
    },
    "nodeSelector": {
      "type": ["object", "null"]
    },
    "tolerations": {
      "type": ["array", "null"],
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "effect": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "effect",
          "key",
          "operator",
          "value"
        ]
      }
    },
    "resources": {
      "type": ["object", "null"]
    },
    "certificateSecrets": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "serverTLS": {
          "type": "string"
        }
      }
    },
    "routeRegistrar": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "certificateSecret": {
          "type": "string"
        },
        "nats": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            }
          }
        },
        "image": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "imagePullPolicy": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": ["object", "null"]
        }
      }
    },
    "uaadb": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "dbScheme": {
          "type": "string",
          "enum": ["postgresql", "postgres", "mysql"]
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": ["string", "null"]
        },
        "tls": {
          "type": "string",
          "enum": ["enabled", "enabled_skip_hostname_validation", "enabled_skip_all_validation", "disabled"]
        },
        "caCertificateSecret": {
          "type": "string"
        },
        "tlsProtocols": {
          "type": ["string", "null"]
        },
        "additionalParameters": {
          "type": ["object", "null"]
        }
      }
    },
    "encryption": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "activeKeyLabel": {
          "type": ["string", "null"]
        },
        "encryptionKeys": {
          "type": ["array", "null"],
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "passphrase": {
                "type": "string",
                "minLength": 8
              }
            },
            "required": ["label", "passphrase"]
          }
        }
      }
    },
    "uaa": {
      "type": "object"
    },
    "login": {
      "type": "object"
    }
  }
}
