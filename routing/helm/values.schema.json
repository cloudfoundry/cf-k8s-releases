      "allOf": [
        {
          "if": {
            "properties": {
              "disableHTTP": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "enableSSL": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enableSSL": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "certificateSecrets": {
                "properties": {
                  "serverTLS": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "perAppPrometheusHTTPMetricsReporting": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "prometheus": {
                "required": [
                  "port"
                ],
                "properties": {
                  "port": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enableVerifyClientCertificateMetadata": {
                "const": true
              },
              "verifyClientCertificateMetadata": {
                "minItems": 1
              }
            }
          },
          "then": {
            "properties": {
              "certificateSecrets": {
                "properties": {
                  "clientCA": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
